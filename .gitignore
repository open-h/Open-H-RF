# Generated example artifacts (written by the example scripts at run time)
examples/tracked-cirs-phantom/data/
examples/tracked-cirs-phantom/3d_views/

# A data card's figures live in an assets/ folder beside it and are checked in; see
# datasets/tue-carotid/assets.
!datasets/**/assets/**

# The Hub repo's documents, cloned by huggingface/setup.sh. Not a submodule: a checkout
# that setup.sh does not guard would pull ~39 TB of LFS payload.
huggingface/Open-H-RF/

# The website build (site/build.py); site/figures/ holds a card figure that is not on the Hub.
site/_site/
!site/figures/*.png
